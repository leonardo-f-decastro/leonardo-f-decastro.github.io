---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-name">Leonardo de Castro <span style="color:#51677e;padding:0 8px">/</span> Portfolio &amp; selected work</p>
      <div class="eyebrow"><span class="small-dot"></span> DATA SCIENCE · APPLIED ML · AI ENGINEERING</div>
      <h1>Science into systems.<br/><span class="accent">Systems into impact.</span></h1>
      <p>I work across statistical modeling, machine learning, and production engineering—turning complex data problems into reliable systems that support better decisions.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="/work/">Explore selected work <span class="arrow" aria-hidden="true">↗</span></a><a class="btn btn-secondary" href="/about/">More about me <span aria-hidden="true">→</span></a></div>
      <div class="pill-row" aria-label="Areas of expertise"><span class="pill">Forecasting &amp; Time Series</span><span class="pill">Applied Machine Learning</span><span class="pill">Cloud &amp; MLOps</span><span class="pill">AI Applications</span></div>
    </div>
    <div class="visual-shell" aria-label="Interactive synthetic forecasting demonstration">
      <div class="terminal">
        <div class="terminal-head"><span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span><span class="terminal-title mono">forecast_validation.ipynb</span><span style="color:#8aa1b4;font-size:14px" aria-hidden="true">↗</span></div>
        <div class="chart-panel"><div class="panel-top"><div><h2>Forecast evaluation lab</h2><p>SYNTHETIC SERIES / 12 WEEKS</p></div><span class="signal-badge">● MODEL STUDY</span></div>
        <div id="forecast-chart">
<svg viewBox="0 0 560 244" role="img" aria-label="Illustrative time series chart comparing observed and forecast values">
  <defs><linearGradient id="fc-gradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6de7ce" stop-opacity=".16"/><stop offset="1" stop-color="#6de7ce" stop-opacity="0"/></linearGradient></defs>
  <g stroke="#263c51" stroke-width="1"><path d="M35 39H535 M35 88H535 M35 137H535 M35 186H535 M35 222H535"/><path d="M35 30V222 M135 30V222 M235 30V222 M335 30V222 M435 30V222 M535 30V222" stroke-dasharray="2 7"/></g>
  <text x="3" y="43" class="chart-label">80</text><text x="3" y="92" class="chart-label">60</text><text x="3" y="141" class="chart-label">40</text><text x="3" y="190" class="chart-label">20</text>
  <text x="35" y="240" class="chart-label">W01</text><text x="235" y="240" class="chart-label">W06</text><text x="442" y="240" class="chart-label">W11</text>
  <path id="chart-fill" class="chart-area" d="M35 177 L80 147 L125 170 L170 100 L215 131 L260 86 L305 114 L350 61 L395 92 L440 52 L485 77 L530 44 L530 222 L35 222 Z" fill="url(#fc-gradient)"/>
  <path id="chart-actual" class="chart-line actual" d="M35 177 L80 147 L125 170 L170 100 L215 131 L260 86 L305 114 L350 61 L395 92 L440 52 L485 77 L530 44" />
  <path id="chart-predict" class="chart-line predict" d="M35 169 L80 151 L125 160 L170 112 L215 135 L260 90 L305 111 L350 72 L395 87 L440 60 L485 75 L530 50"/>
  <circle id="last-marker" cx="530" cy="44" r="4.5" fill="#8db2ff" stroke="#102034" stroke-width="3" />
</svg>
</div>
        <div class="legend"><span><i></i>Observed demand</span><span class="forecast"><i></i>Illustrative forecast</span></div></div>
        <div class="terminal-controls"><div class="control-label">Explore different demand patterns</div>
          <div class="segments" role="group" aria-label="Choose a demand pattern"><button class="segment" data-pattern="seasonal" aria-pressed="true">Seasonal</button><button class="segment" data-pattern="intermittent" aria-pressed="false">Intermittent</button><button class="segment" data-pattern="trending" aria-pressed="false">Trending</button></div>
          <div class="chart-foot"><span id="pattern-note" aria-live="polite">Recurring peaks and troughs</span><span>MODELS ≠ MAGIC</span></div>
        </div>
      </div><p class="hero-outnote">Interactive illustration · synthetic data only</p>
    </div>
  </div>
</section>
