---
import '../styles/global.css';
const { title = 'Leonardo de Castro — Data Science, Applied ML & AI Engineering', description = 'Senior data science, applied machine learning, AI engineering and thoughtful production systems.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  {url:'/',name:'Home'},
  {url:'/work/',name:'Work'},
  {url:'/writing/',name:'Writing'},
  {url:'/about/',name:'About'},
  {url:'/contact/',name:'Contact'},
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0a101a" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="topline" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/" aria-label="Leonardo de Castro, home">
          <span class="brand-mark" aria-hidden="true">L/C</span>
          <span class="brand-text">Leonardo de Castro<span class="brand-sub">DATA SCIENCE · APPLIED AI</span></span>
        </a>
        <nav class="nav-links" id="site-navigation" aria-label="Main navigation">
          {nav.map(n => <a href={n.url} aria-current={path === n.url ? 'page' : undefined}>{n.name}</a>)}
        </nav>
        <a class="nav-cta" href="/contact/">Let’s connect ↗</a>
        <button class="hamburger" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Toggle menu">☰</button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-row">
        <p>© {new Date().getFullYear()} Leonardo de Castro. Built with care, evidence, and curiosity.</p>
        <nav class="footer-links" aria-label="Footer"><a href="/work/">Work</a><a href="/writing/">Writing</a><a href="https://github.com/leonardo-f-decastro" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
      </div>
    </footer>
    <script is:inline>
      const menuButton = document.querySelector('.hamburger');
      const navMenu = document.getElementById('site-navigation');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(open));
        navMenu?.classList.toggle('open', open);
      });
      navMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {navMenu.classList.remove('open'); menuButton?.setAttribute('aria-expanded','false');}));
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(entries => {entries.forEach(e => {if(e.isIntersecting){e.target.classList.add('in-view');observer.unobserve(e.target)}})}, {threshold:0.08});
        document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
      } else {document.querySelectorAll('.reveal').forEach(el=>el.classList.add('in-view'));}
    </script>
  </body>
</html>
